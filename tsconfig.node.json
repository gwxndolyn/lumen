{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "sourceMap": true
  },
  "include": ["electron/**/*.ts", "src/core/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
