{
  "name": "lumen-assistant",
  "productName": "Lumen",
  "version": "0.3.0",
  "description": "Lumen \u2014 a local-first, context-aware AI desktop assistant",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "smoke": "npm run build && bash scripts/smoke.sh",
    "dev": "npm run build && electron .",
    "lint": "oxlint --deny-warnings electron src scripts",
    "check": "npm run typecheck && npm run lint && npm test",
    "format": "node scripts/format-changed.mjs",
    "format:write": "node scripts/format-changed.mjs --write",
    "test:live": "vitest run --config vitest.live.config.mts",
    "audit:prod": "node scripts/audit-shipped.mjs",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "smoke:packaged": "bash scripts/smoke-packaged.sh",
    "release:check": "npm run check && npm run audit:prod && npm run build",
    "format:all": "prettier --check \"electron/**/*.ts\" \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\"",
    "audit:raw": "npm audit --omit=dev --audit-level=high"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "mammoth": "^1.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "author": {
    "name": "Lumen"
  },
  "homepage": "https://example.invalid/lumen",
  "engines": {
    "node": ">=22.5"
  }
}
