<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's V8 JIT and the OCR WebAssembly engine under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <!-- Microphone for live transcription (user-initiated, with the usage string in Info.plist). -->
  <key>com.apple.security.device.audio-input</key><true/>
  <!-- Outgoing HTTPS/WSS to the configured AI and transcription providers. -->
  <key>com.apple.security.network.client</key><true/>
</dict>
</plist>
